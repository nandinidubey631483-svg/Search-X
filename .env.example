# ==============================================================================
# SearchX Configuration Template
# ==============================================================================
# Copy this file to .env and customize for your environment:
#   cp .env.example .env

# --- Administration & Security ---
SEARCHX_ADMIN_KEY=searchx-admin-secret

# --- PostgreSQL Database ---
POSTGRES_USER=searchx
POSTGRES_PASSWORD=searchx_secure_pass
POSTGRES_DB=searchx
DATABASE_URL=postgresql://searchx:searchx_secure_pass@localhost:5432/searchx

# --- Redis Caching Layer ---
REDIS_URL=redis://localhost:6379/0
SEARCHX_CACHE_ENABLED=true
SEARCHX_CACHE_TTL=300

# --- C++ Core Retrieval Engine Binary & Inverted Index ---
# For local Windows development:
SEARCHX_ENGINE_BIN=core-engine/build/searchx_engine.exe
SEARCHX_INDEX_PATH=searchx_index.bin

# For local Linux / macOS development:
# SEARCHX_ENGINE_BIN=core-engine/build/searchx_engine
# SEARCHX_INDEX_PATH=searchx_index.bin
